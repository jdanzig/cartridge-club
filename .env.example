# ─────────────────────────────────────────────────────────────────────────────
# Cartridge Club Supply — sandbox environment template
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify store ────────────────────────────────────────────────────────────
# Your Shopify dev store myshopify domain, e.g. cartridge-club-dev.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API version — pin to a stable release.
SHOPIFY_API_VERSION=2025-01

# ── Admin API (custom app, server-side) ──────────────────────────────────────
# Create a custom app in your dev store admin (Settings → Apps → Develop apps)
# and grant scopes: read_products, write_products, read_inventory, write_inventory,
# read_metaobjects, write_metaobjects, read_orders, write_webhooks, read_files,
# write_files, read_publications, write_publications.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Storefront API (public, used by the headless finder) ─────────────────────
# Same custom app — enable the Storefront API and copy the public token.
SHOPIFY_STOREFRONT_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01

# ── Partner app (for the embedded Remix app + Functions) ─────────────────────
# Created in partners.shopify.com → Apps → Create app.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel-host.trycloudflare.com
SCOPES=read_products,write_products,read_orders,write_metaobjects,read_metaobjects

# ── Webhook service (FastAPI) ────────────────────────────────────────────────
# Shopify uses the Admin API secret OR per-webhook subscription secret to sign
# webhook payloads. For app-registered webhooks this is the API secret above.
SHOPIFY_WEBHOOK_SECRET=
WEBHOOK_SERVICE_PORT=8000
WEBHOOK_SERVICE_DB_PATH=./data/webhooks.sqlite

# Optional: log level for the FastAPI service.
LOG_LEVEL=INFO
